# ---------------------------------------------------------------------------
# Code Review & Debug Squad — environment configuration
# Copy this file to `.env` and choose one provider.
# ---------------------------------------------------------------------------

# Transport: google | openai | ollama | demo
# `demo` is a deterministic offline chat model; it needs no credentials and is
# useful for evaluating the complete GUI. Use google/openai/ollama for real LLM
# inference through LangChain.
LLM_PROVIDER=demo

# Leave blank to use the provider default:
#   google  -> gemini-2.0-flash
#   openai  -> gpt-4o-mini
#   ollama  -> qwen2.5-coder:7b
#   demo    -> code-review-squad-demo
LLM_MODEL=
LLM_TEMPERATURE=0.1

# --- Google Gemini ---------------------------------------------------------
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=

# --- OpenAI or an OpenAI-compatible gateway --------------------------------
OPENAI_API_KEY=
# Change to a compatible gateway if required, e.g. http://localhost:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local Ollama ----------------------------------------------------------
# Install Ollama, run `ollama serve`, then `ollama pull qwen2.5-coder:7b`.
OLLAMA_BASE_URL=http://localhost:11434

# --- Agentic RAG / ChromaDB ------------------------------------------------
CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION=coding_guidelines
KNOWLEDGE_BASE_DIR=./knowledge_base
RAG_TOP_K=4
# Downloads once, then works offline. Fallback hashing embeddings are automatic.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Isolated sandbox ------------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=5
MAX_TEST_RETRIES=1
